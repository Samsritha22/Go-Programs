package main
import (
"database/sql"
"fmt"
_ "github.com/go-sql-driver/mysql"
)
var db *sql.DB
func main() {
// Connect to MySQL
var err error
db, err = sql.Open(
"mysql",
"root:Password@tcp(127.0.0.1:3306)/db",
)
if err != nil {
fmt.Println("Error opening database:", err)
return
}
// Check database connection
err = db.Ping()
if err != nil {
fmt.Println("Error connecting to database:", err)
return
}
fmt.Println("Connected to MySQL successfully!")
defer db.Close()
for {
fmt.Println("\n===== STUDENT MANAGEMENT SYSTEM =====")
fmt.Println("1. Create Student")
fmt.Println("2. Read Students")
fmt.Println("3. Update Student")
fmt.Println("4. Delete Student")
fmt.Println("5. Exit")
var choice int
fmt.Print("Enter your choice: ")
fmt.Scan(&choice)
switch choice {
case 1:
createStudent()
case 2:
readStudents()
case 3:
updateStudent()
case 4:
deleteStudent()
case 5:
fmt.Println("Program terminated.")
return
default:
fmt.Println("Invalid choice!")
}
}
}
// CREATE
func createStudent() {
var name string
var age int
var course string
fmt.Print("Enter student name: ")
fmt.Scan(&name)
fmt.Print("Enter age: ")
fmt.Scan(&age)
fmt.Print("Enter course: ")
fmt.Scan(&course)
query := `
INSERT INTO students (name, age, course)
VALUES (?, ?, ?)
`
result, err := db.Exec(query, name, age, course)
if err != nil {
fmt.Println("Error inserting student:", err)
return
}
id, err := result.LastInsertId()
if err != nil {
fmt.Println("Error getting student ID:", err)
return
}
fmt.Println("Student created successfully!")
fmt.Println("Student ID:", id)
}
// READ
func readStudents() {
query := `
SELECT id, name, age, course
FROM students
`
rows, err := db.Query(query)
if err != nil {
fmt.Println("Error reading students:", err)
return
}
defer rows.Close()
fmt.Println("\nID\tName\tAge\tCourse")
fmt.Println("--------------------------------")
for rows.Next() {
var id int
var name string
var age int
var course string
err := rows.Scan(
&id,
&name,
&age,
&course,
)
if err != nil {
fmt.Println("Error scanning data:", err)
return
}
fmt.Printf(
"%d\t%s\t%d\t%s\n",
id,
name,
age, course,
)
}
if err := rows.Err(); err != nil {
fmt.Println("Error reading rows:", err)
}
}
// UPDATE
func updateStudent() {
var id int
var name string
var age int
var course string
fmt.Print("Enter student ID to update: ")
fmt.Scan(&id)
fmt.Print("Enter new name: ")
fmt.Scan(&name)
fmt.Print("Enter new age: ")
fmt.Scan(&age)
fmt.Print("Enter new course: ")
fmt.Scan(&course)
query := `
UPDATE students
SET name = ?, age = ?, course = ?
WHERE id = ?
`
result, err := db.Exec(
query,
name,
age,
course,
id,
)
if err != nil {
fmt.Println("Error updating student:", err)
return
}
rowsAffected, err := result.RowsAffected()
if err != nil {
fmt.Println("Error checking update:", err)
return
}
if rowsAffected == 0 {
fmt.Println("Student not found.")
return
}
fmt.Println("Student updated successfully!")
}
// DELETE
func deleteStudent() {
var id int
fmt.Print("Enter student ID to delete: ")
fmt.Scan(&id)
query := `
DELETE FROM students
WHERE id = ?
`
result, err := db.Exec(query, id)
if err != nil {
fmt.Println("Error deleting student:", err)
return
}
rowsAffected, err := result.RowsAffected()
if err != nil {
fmt.Println("Error checking deletion:", err)
return
}
if rowsAffected == 0 {
fmt.Println("Student not found.")
return
}
fmt.Println("Student deleted successfully!")
}
